<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fintrack.controller.AccountController">

    <!-- Sidebar Navigation -->
    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml" />
    </left>

    <!-- Main Content -->
    <center>
        <VBox styleClass="main-content" spacing="24">
            
            <!-- Header Area -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4">
                    <Label text="Accounts" styleClass="h1"/>
                    <Label text="Manage your bank accounts, wallets, and credit cards" styleClass="text-muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="New Account" onAction="#handlePrepareAdd" styleClass="button-primary">
                    <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
                </Button>
            </HBox>

            <!-- Metrics / Summary -->
            <HBox spacing="24">
                <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <HBox styleClass="metric-header">
                        <VBox styleClass="metric-icon-box"><FontIcon iconLiteral="fas-piggy-bank" iconColor="#64748B"/></VBox>
                        <Label text="Total Net Worth" styleClass="metric-title"/>
                    </HBox>
                    <Label fx:id="lblTotalNetWorth" text="--" styleClass="metric-value"/>
                </VBox>
            </HBox>

            <!-- Layout: Table on Left, Form on Right -->
            <HBox spacing="24" VBox.vgrow="ALWAYS">
                
                <!-- Table Area -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="16">
                    <TableView fx:id="tableAccounts" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colName" text="Account Name" prefWidth="250"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="150"/>
                            <TableColumn fx:id="colBalance" text="Current Balance" prefWidth="150"/>
                            <TableColumn fx:id="colActions" text="Actions" prefWidth="100" sortable="false"/>
                        </columns>
                        <placeholder>
                            <Label text="No accounts found. Add one to get started." styleClass="text-muted"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Account Form Card -->
                <VBox fx:id="formCard" styleClass="card" prefWidth="350" spacing="20" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblFormTitle" text="New Account" styleClass="h2"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleCancel" styleClass="action-icon-button" style="-fx-border-width: 0;">
                            <graphic><FontIcon iconLiteral="fas-times" iconColor="#64748B"/></graphic>
                        </Button>
                    </HBox>

                    <VBox spacing="12">
                        <VBox spacing="4">
                            <Label text="Account Name *" styleClass="label"/>
                            <TextField fx:id="txtName" promptText="e.g., Chase Checking"/>
                        </VBox>
                        
                        <VBox spacing="4">
                            <Label text="Account Type *" styleClass="label"/>
                            <ComboBox fx:id="cmbType" maxWidth="Infinity" promptText="Select Type"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Starting Balance *" styleClass="label"/>
                            <HBox alignment="CENTER_LEFT" styleClass="text-field" style="-fx-padding: 0 12px;">
                                <Label text="&#36;" styleClass="text-muted" style="-fx-font-weight: 600;"/>
                                <TextField fx:id="txtBalance" promptText="0.00" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 16px; -fx-font-weight: 600;" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <HBox spacing="12">
                        <Button text="Cancel" onAction="#handleCancel" styleClass="button-secondary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Save Account" onAction="#handleSave" styleClass="button-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
