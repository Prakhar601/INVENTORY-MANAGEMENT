<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fintrack.controller.TransactionController">

    <!-- Sidebar Navigation -->
    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml" />
    </left>

    <!-- Main Content -->
    <center>
        <VBox styleClass="main-content" spacing="24">
            
            <!-- Header Area -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4">
                    <Label text="Transactions" styleClass="h1"/>
                    <Label text="Manage and track your income and expenses" styleClass="text-muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Export CSV" onAction="#handleExport" styleClass="button-secondary">
                    <graphic><FontIcon iconLiteral="fas-file-export"/></graphic>
                </Button>
                <Button text="New Transaction" onAction="#handlePrepareAdd" styleClass="button-primary">
                    <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
                </Button>
            </HBox>

            <!-- Advanced Filters Area -->
            <VBox styleClass="card" spacing="12" style="-fx-padding: 16px;">
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="Search" styleClass="label, text-muted"/>
                        <HBox alignment="CENTER_LEFT" styleClass="text-field" style="-fx-pref-width: 250px;">
                            <FontIcon iconLiteral="fas-search" iconColor="#94A3B8"/>
                            <TextField fx:id="txtSearch" promptText="Keywords..." style="-fx-background-color: transparent; -fx-border-width: 0;" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>
                    
                    <VBox spacing="4">
                        <Label text="Type" styleClass="label, text-muted"/>
                        <ComboBox fx:id="cmbFilterType" prefWidth="120" />
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Category" styleClass="label, text-muted"/>
                        <ComboBox fx:id="cmbFilterCategory" prefWidth="150" />
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Date Range" styleClass="label, text-muted"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <DatePicker fx:id="dpFilterFrom" prefWidth="130" promptText="From" />
                            <Label text="-" styleClass="text-muted"/>
                            <DatePicker fx:id="dpFilterTo" prefWidth="130" promptText="To" />
                        </HBox>
                    </VBox>
                </HBox>
                
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="Amount Range" styleClass="label, text-muted"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="txtMinAmount" promptText="Min amount" prefWidth="100"/>
                            <Label text="-" styleClass="text-muted"/>
                            <TextField fx:id="txtMaxAmount" promptText="Max amount" prefWidth="100"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="4">
                        <Label text="Sort By" styleClass="label, text-muted"/>
                        <ComboBox fx:id="cmbSortBy" prefWidth="150" />
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />
                    
                    <VBox spacing="4" alignment="BOTTOM_CENTER">
                        <Label text=" "/>
                        <Button text="Reset Filters" onAction="#handleClearFilter" styleClass="button-secondary">
                            <graphic><FontIcon iconLiteral="fas-sync-alt"/></graphic>
                        </Button>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Layout: Table on Left, Form on Right -->
            <HBox spacing="24" VBox.vgrow="ALWAYS">
                
                <!-- Table Area -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="16">
                    <TableView fx:id="tableTransactions" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                            <TableColumn fx:id="colDesc" text="Description" prefWidth="250"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                            <TableColumn fx:id="colCategory" text="Category" prefWidth="140"/>
                            <TableColumn fx:id="colAccount" text="Account" prefWidth="140"/>
                            <TableColumn fx:id="colAmount" text="Amount" prefWidth="120"/>
                            <TableColumn fx:id="colActions" text="Actions" prefWidth="100" sortable="false"/>
                        </columns>
                        <placeholder>
                            <Label text="No transactions found." styleClass="text-muted"/>
                        </placeholder>
                    </TableView>
                    
                    <!-- Pagination Controls -->
                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Label fx:id="lblPaginationInfo" text="Showing 1-15 of 45" styleClass="text-muted"/>
                        <Button fx:id="btnPrevPage" onAction="#handlePrevPage" styleClass="button-secondary">
                            <graphic><FontIcon iconLiteral="fas-chevron-left"/></graphic>
                        </Button>
                        <Button fx:id="btnNextPage" onAction="#handleNextPage" styleClass="button-secondary">
                            <graphic><FontIcon iconLiteral="fas-chevron-right"/></graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- Transaction Form Card -->
                <VBox fx:id="formCard" styleClass="card" prefWidth="350" spacing="20" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblFormTitle" text="New Transaction" styleClass="h2"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleCancel" styleClass="action-icon-button" style="-fx-border-width: 0;">
                            <graphic><FontIcon iconLiteral="fas-times" iconColor="#64748B"/></graphic>
                        </Button>
                    </HBox>

                    <VBox spacing="12">
                        <VBox spacing="4">
                            <Label text="Type *" styleClass="label"/>
                            <ComboBox fx:id="cmbType" maxWidth="Infinity" onAction="#handleTypeChange"/>
                        </VBox>
                        
                        <VBox spacing="4">
                            <Label text="Amount *" styleClass="label"/>
                            <HBox alignment="CENTER_LEFT" styleClass="text-field" style="-fx-padding: 0 12px;">
                                <Label fx:id="lblCurrencySymbol" text="USD" styleClass="text-muted" style="-fx-font-weight: 600;"/>
                                <TextField fx:id="txtAmount" promptText="0.00" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 16px; -fx-font-weight: 600;" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Description *" styleClass="label"/>
                            <TextField fx:id="txtDescription" promptText="e.g., Groceries at Whole Foods"/>
                        </VBox>
                        
                        <VBox spacing="4">
                            <Label text="Category *" styleClass="label"/>
                            <ComboBox fx:id="cmbCategory" maxWidth="Infinity" promptText="Select Category"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Account *" styleClass="label"/>
                            <ComboBox fx:id="cmbAccount" maxWidth="Infinity" promptText="Select Account"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Date *" styleClass="label"/>
                            <DatePicker fx:id="dpDate" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <HBox spacing="12">
                        <Button text="Cancel" onAction="#handleCancel" styleClass="button-secondary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Save Transaction" onAction="#handleSave" styleClass="button-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
