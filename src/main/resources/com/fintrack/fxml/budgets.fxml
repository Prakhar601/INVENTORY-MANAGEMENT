<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fintrack.controller.BudgetController">

    <!-- Sidebar Navigation -->
    <left>
        <fx:include fx:id="sidebar" source="sidebar.fxml" />
    </left>

    <!-- Main Content -->
    <center>
        <VBox styleClass="main-content" spacing="24">
            
            <!-- Header Area -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="4">
                    <Label text="Budgets" styleClass="h1"/>
                    <Label text="Set limits and track your spending goals" styleClass="text-muted"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="New Budget" onAction="#handlePrepareAdd" styleClass="button-primary">
                    <graphic><FontIcon iconLiteral="fas-bullseye"/></graphic>
                </Button>
            </HBox>

            <!-- Metrics / Summary -->
            <HBox spacing="24">
                <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <HBox styleClass="metric-header">
                        <VBox styleClass="metric-icon-box"><FontIcon iconLiteral="fas-chart-line" iconColor="#64748B"/></VBox>
                        <Label text="Total Budget Allocation" styleClass="metric-title"/>
                    </HBox>
                    <Label fx:id="lblTotalAllocated" text="--" styleClass="metric-value"/>
                </VBox>
                
                <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <HBox styleClass="metric-header">
                        <VBox styleClass="metric-icon-box, expense"><FontIcon iconLiteral="fas-exclamation-triangle" iconColor="#EF4444"/></VBox>
                        <Label text="At Risk Budgets" styleClass="metric-title"/>
                    </HBox>
                    <Label fx:id="lblAtRisk" text="0" styleClass="metric-value"/>
                </VBox>
            </HBox>

            <!-- Layout: Table on Left, Form on Right -->
            <HBox spacing="24" VBox.vgrow="ALWAYS">
                
                <!-- Table Area -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="16">
                    <TableView fx:id="tableBudgets" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCategory" text="Category" prefWidth="150"/>
                            <TableColumn fx:id="colPeriod" text="Period" prefWidth="100"/>
                            <TableColumn fx:id="colAmount" text="Budget Limit" prefWidth="120"/>
                            <TableColumn fx:id="colSpent" text="Spent" prefWidth="120"/>
                            <TableColumn fx:id="colProgress" text="Progress" prefWidth="200"/>
                            <TableColumn fx:id="colActions" text="Actions" prefWidth="100" sortable="false"/>
                        </columns>
                        <placeholder>
                            <Label text="No active budgets. Create one to start tracking." styleClass="text-muted"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Budget Form Card -->
                <VBox fx:id="formCard" styleClass="card" prefWidth="350" spacing="20" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblFormTitle" text="New Budget" styleClass="h2"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleCancel" styleClass="action-icon-button" style="-fx-border-width: 0;">
                            <graphic><FontIcon iconLiteral="fas-times" iconColor="#64748B"/></graphic>
                        </Button>
                    </HBox>

                    <VBox spacing="12">
                        <VBox spacing="4">
                            <Label text="Category *" styleClass="label"/>
                            <ComboBox fx:id="cmbCategory" maxWidth="Infinity" promptText="Select Category"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Budget Amount *" styleClass="label"/>
                            <HBox alignment="CENTER_LEFT" styleClass="text-field" style="-fx-padding: 0 12px;">
                                <Label text="&#36;" styleClass="text-muted" style="-fx-font-weight: 600;"/>
                                <TextField fx:id="txtAmount" promptText="0.00" style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 16px; -fx-font-weight: 600;" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                        
                        <VBox spacing="4">
                            <Label text="Period *" styleClass="label"/>
                            <ComboBox fx:id="cmbPeriod" maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Start Date *" styleClass="label"/>
                            <DatePicker fx:id="dpStart" maxWidth="Infinity"/>
                        </VBox>
                        
                        <VBox spacing="4">
                            <Label text="End Date *" styleClass="label"/>
                            <DatePicker fx:id="dpEnd" maxWidth="Infinity"/>
                        </VBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <HBox spacing="12">
                        <Button text="Cancel" onAction="#handleCancel" styleClass="button-secondary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Save Budget" onAction="#handleSave" styleClass="button-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
